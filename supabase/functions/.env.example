# Copier en supabase/functions/.env puis renseigner la clé du provider choisi.
# Chargé automatiquement par `supabase start` / `supabase functions serve`.

# "claude" (défaut) ou "deepseek"
AI_PROVIDER=claude

# Si AI_PROVIDER=claude
ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-sonnet-5

# Si AI_PROVIDER=deepseek
DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=deepseek-chat
